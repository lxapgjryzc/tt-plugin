{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.2.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://tenten.art/*", "http://127.0.0.1:47815/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://tenten.art/*"],
      "js": ["src/content/tz-fix.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://tenten.art/*"],
      "js": ["src/content/homework-badge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:47815/*", "http://localhost:47815/*"],
      "js": ["src/content/pair.js"],
      "run_at": "document_idle"
    }
  ]
}
